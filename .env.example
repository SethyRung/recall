# Local Postgres (Docker)
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall

# Nuxt Hub database
DATABASE_DRIVER=postgres-js
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall

# Nuxt Hub Blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Better Auth
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_BETTER_AUTH_SECRET=

# Password reset email (Resend)
NUXT_RESEND_API_KEY=
# Use a sender on your verified Resend domain, e.g. Recall <noreply@example.com>
NUXT_RESEND_FROM_EMAIL=

# LLM provider (Anthropic-compatible)
NUXT_LLM_BASE_URL=
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=

# Embeddings provider (OpenRouter)
NUXT_EMBED_BASE_URL=
NUXT_EMBED_API_KEY=
NUXT_EMBED_MODEL=

# Retrieval
NUXT_TOP_K=5
NUXT_SIMILARITY_THRESHOLD=0.3

# Chunking
NUXT_CHUNK_SIZE=500
NUXT_CHUNK_OVERLAP=50
