# Local Postgres (Docker)
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall

# Nuxt Hub database
DATABASE_DRIVER=postgres-js
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall

# Nuxt Hub Blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Better Auth
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_BETTER_AUTH_SECRET=

# Stable root secret for encrypted Admin settings (Nuxt deriveSecret)
# Generate once: openssl rand -base64 32
NUXT_APP_SECRET=

# Private server-to-server chat API.
NUXT_CHAT_API_KEY=
# Comma-separated external origins, such as https://sethyrung.com. API key still required.
NUXT_CHAT_API_TRUSTED_ORIGINS=

# Configure models, embedding credentials, retrieval, chunking and Resend in /admin/settings.
